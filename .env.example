MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=resumeiq
MYSQL_USER=root
MYSQL_PASSWORD=
# Local development only. Never accepted in production or on non-loopback requests.
AUTH_SMS_MODE=development
AUTH_DEV_CODE=123456
APP_ORIGIN=http://127.0.0.1:3000

# Real SMS (set AUTH_SMS_MODE=tencent). The approved template must accept
# parameter 1 = verification code and parameter 2 = valid minutes.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_CODE_MINUTES=5
TENCENT_SMS_REGION=ap-guangzhou

# LLM Model Eval Tool. Keep real keys in .env.local only.
OPENAI_API_KEY=
EVAL_OPENAI_MODEL=
EVAL_OPENAI_INPUT_USD_PER_1M=
EVAL_OPENAI_OUTPUT_USD_PER_1M=

ANTHROPIC_API_KEY=
EVAL_ANTHROPIC_MODEL=
EVAL_ANTHROPIC_INPUT_USD_PER_1M=
EVAL_ANTHROPIC_OUTPUT_USD_PER_1M=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_OCR_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_INPUT_CNY_PER_1M=
DEEPSEEK_CACHED_INPUT_CNY_PER_1M=
DEEPSEEK_OUTPUT_CNY_PER_1M=
EVAL_DEEPSEEK_MODEL=
EVAL_DEEPSEEK_INPUT_USD_PER_1M=
EVAL_DEEPSEEK_OUTPUT_USD_PER_1M=
