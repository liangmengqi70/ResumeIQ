    "server-only": "^0.0.1",
    "tencentcloud-sdk-nodejs": "^4.1.314"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
